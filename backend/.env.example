# Copy to backend/.env for local development and fill in what you need.
# backend/.env is git-ignored; keep real secrets out of this example file.
# On the server, set these on the NSSM service instead (nssm edit DashLinkTree);
# service settings always win over backend/.env.
# Every variable is described in README.md, "Production settings".

# OCI IAM identity domain the console manages. Leave the URL empty to use demo data.
OCI_IDENTITY_DOMAIN_URL=
# The console's confidential application (OCI Console -> Domains -> Integrated applications)
OCI_CLIENT_ID=
OCI_CLIENT_SECRET=

# Optional: a separate OCI application for staff sign-in (defaults to the one above)
# OCI_SSO_CLIENT_ID=
# OCI_SSO_CLIENT_SECRET=
# OCI_SSO_ISSUER=

# Optional: AD sign-in and console access
# CONSOLE_SSO=True
# CONSOLE_PUBLIC_URL=
# CONSOLE_STAFF_GROUPS=Dash Console Admins
# CONSOLE_SUPERUSER_GROUPS=Dash Console Superusers
# CONSOLE_ACT_AS_USER=True
# CONSOLE_LOCAL_LOGIN=

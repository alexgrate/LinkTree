<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS config for the Dash MFB LinkTree site. Vite copies this into dist/ on every build. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Send API, admin and Django static requests to the Waitress service (NSSM: DashLinkTree). -->
        <rule name="Django backend" stopProcessing="true">
          <match url="^(api|admin|static)(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:0}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
